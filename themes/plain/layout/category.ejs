<header class="page-header">
  <h1>分类：<%= page.category %></h1>
  <p>共 <%= page.posts.length %> 篇</p>
</header>
<ul class="simple-list">
  <% page.posts.each(function (post) { %>
    <li><time><%= date(post.date, 'YYYY-MM-DD') %></time><a href="<%- url_for(post.path) %>"><%= post.title %></a></li>
  <% }) %>
</ul>
