<section class="home-intro">
  <div class="intro-main">
    <p class="intro-kicker">WELCOME</p>
    <h1 class="intro-title">欢迎光临</h1>
    <p class="intro-text">这里是不吃香菜的博客。欢迎各位旅行者，开拓者，漂泊者，博士，舰长，天命人，褪色者，守护者，召唤师，绳匠，提督，指挥官，寻梦者，局长，sensei，列车长，收藏家，归还者，狩月人，星临者，导演，觉醒者，分析员，训练员，船长，鉴定师，御主，小画家，来到我的博客。</p>
    <div class="intro-labels">
      <span>数学系</span><span>嘤嘤嘤</span><span>Go</span><span>Gin</span><span>后端</span><span>香菜黑</span><span>数学好难</span><span>奶茶续命</span>
    </div>
    <p class="intro-note">有一说一，从这段简介大概能看出我的精神状态。<a href="<%- url_for('/about/') %>">关于我 →</a></p>
  </div>
  <img class="intro-avatar" src="<%- url_for('/img/avatar.png') %>?v=2" alt="不吃香菜">
</section>

<% var posts = page.posts.toArray(); %>
<div class="home">
  <section class="home-main">
    <h1 class="section-title">文章</h1>
    <ul class="post-list">
      <% posts.forEach(function (post) { %>
        <li class="post-item">
          <div class="post-meta">
            <time><%= date(post.date, 'YYYY-MM-DD') %></time>
            <span><%= first_category(post) %></span>
          </div>
          <h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
          <p><%= plain_excerpt(post, 110) %></p>
        </li>
      <% }) %>
    </ul>
    <% if (page.total > 1) { %>
      <div class="pager">
        <% if (page.prev_link) { %><a href="<%- url_for(page.prev_link) %>">← 上一页</a><% } %>
        <span><%= page.current %> / <%= page.total %></span>
        <% if (page.next_link) { %><a href="<%- url_for(page.next_link) %>">下一页 →</a><% } %>
      </div>
    <% } %>
  </section>

  <aside class="home-side">
    <section class="side-block">
      <h2>分类</h2>
      <ul class="side-list">
        <% site.categories.sort('name').each(function (cat) { %>
          <li><a href="<%- url_for(cat.path) %>"><%= cat.name %></a><span><%= cat.length %></span></li>
        <% }) %>
      </ul>
    </section>
    <section class="side-block">
      <h2>标签</h2>
      <div class="side-tags">
        <% site.tags.sort('name').each(function (tag) { %>
          <a href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
        <% }) %>
      </div>
    </section>
    <section class="side-block">
      <h2>友链</h2>
      <p><a href="<%- url_for('/links/') %>">朋友们 →</a></p>
    </section>
  </aside>
</div>
