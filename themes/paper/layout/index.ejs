<% var posts = page.posts.toArray(); %>
<% var featured = posts.find(function (p) { return p.featured; }) || posts[0]; %>
<% var rest = posts.filter(function (p) { return p !== featured; }); %>

<% if (featured) { %>
<section class="feature">
  <div class="kicker">
    <span><%= first_category(featured) %></span>
    <span><%= date(featured.date, 'YYYY-MM-DD') %></span>
    <span class="kicker-latest"><%= featured.featured ? '精选' : '最新' %></span>
  </div>
  <h1 class="feature-title"><a href="<%- url_for(featured.path) %>"><%= featured.title %></a></h1>
  <p class="lede"><%= plain_excerpt(featured, 130) %></p>
  <div class="meta">
    <span>约 <%= reading_time(featured) %> 分钟</span>
    <% featured.tags.each(function (tag) { %><span class="hash">#<%= tag.name %></span><% }) %>
  </div>
</section>
<% } %>

<section class="section">
  <div class="section-head">
    <h2>近期文章</h2>
    <a class="more" href="<%- url_for('/archives/') %>">全部 <%= site.posts.length %> 篇 →</a>
  </div>

  <ul class="post-list">
    <% rest.forEach(function (post) { %>
      <li class="post-item">
        <div class="post-date"><%= date(post.date, 'MM-DD') %><em><%= date(post.date, 'YYYY') %></em></div>
        <div class="post-body">
          <div class="post-cat"><%= first_category(post) %></div>
          <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
          <p><%= plain_excerpt(post, 90) %></p>
        </div>
      </li>
    <% }) %>
  </ul>

  <% if (page.total > 1) { %>
    <div class="pager">
      <% if (page.prev_link) { %><a href="<%- url_for(page.prev_link) %>">← 新一点</a><% } %>
      <span><%= page.current %> / <%= page.total %></span>
      <% if (page.next_link) { %><a href="<%- url_for(page.next_link) %>">旧一点 →</a><% } %>
    </div>
  <% } %>
</section>
