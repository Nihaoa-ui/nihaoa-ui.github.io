<% var posts = site.posts.sort('-date').toArray(); %>
<% var groups = {}; posts.forEach(function (p) { var y = date(p.date, 'YYYY'); (groups[y] = groups[y] || []).push(p); }); %>

<header class="list-header">
  <h1>归档</h1>
  <p>共 <%= posts.length %> 篇，按时间倒序。</p>
</header>

<% Object.keys(groups).forEach(function (year) { %>
  <section class="year">
    <h2><%= year %><em><%= groups[year].length %> 篇</em></h2>
    <ul class="archive-list">
      <% groups[year].forEach(function (post) { %>
        <li>
          <time><%= date(post.date, 'MM-DD') %></time>
          <a href="<%- url_for(post.path) %>"><%= post.title %></a>
        </li>
      <% }) %>
    </ul>
  </section>
<% }) %>
