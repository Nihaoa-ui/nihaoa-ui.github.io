<header class="topbar">
  <div class="container topbar-inner">
    <a class="brand" href="<%- url_for('/') %>">
      <span class="brand-name"><%= config.title %></span>
      <span class="brand-sub">NOTES</span>
    </a>
    <nav class="nav">
      <% (theme.menu || []).forEach(function (item) { %>
        <a href="<%- url_for(item.url) %>"><%= item.name %></a>
      <% }) %>
    </nav>
    <span class="seal" aria-hidden="true">董</span>
  </div>
</header>
