<header class="list-header">
  <h1>分类 · <%= page.category %></h1>
  <p>共 <%= page.posts.length %> 篇</p>
</header>
<ul class="post-list">
  <% page.posts.each(function (post) { %>
    <li class="post-item">
      <div class="post-date"><%= date(post.date, 'MM-DD') %><em><%= date(post.date, 'YYYY') %></em></div>
      <div class="post-body">
        <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
        <p><%= plain_excerpt(post, 90) %></p>
      </div>
    </li>
  <% }) %>
</ul>
